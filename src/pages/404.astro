---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Page not found – Krayneli">
  <Header />
  <main id="main-content" class="flex flex-col items-center justify-center px-8 py-40 text-center">
    <h1 class="mb-4 text-4xl font-semibold text-black md:text-5xl">Page not found</h1>
    <p class="mb-8 max-w-md text-lg text-black/70">
      That page doesn't exist — but the voice you're looking for is still on the homepage.
    </p>
    <a
      href="/"
      class="inline-block bg-brand-primary px-6 py-4 text-xs font-semibold tracking-[1px] text-white uppercase transition-colors hover:bg-brand-primary-dark"
    >
      Back to homepage
    </a>
  </main>
  <Footer />
</Layout>
