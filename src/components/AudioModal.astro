---
import type { Service } from "../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<dialog
  id={`modal-${service.id}`}
  data-audio-modal
  class="fixed inset-0 m-auto w-[92vw] max-w-xl border-0 bg-white p-0 text-black shadow-2xl backdrop:bg-black/80"
>
  <div class="flex max-h-[85vh] flex-col">
    <header class="flex items-center justify-between border-b border-black/10 px-6 py-4">
      <h3 class="text-sm font-semibold tracking-[0.5px] uppercase">{service.title}</h3>
      <button
        type="button"
        data-modal-close
        aria-label="Close"
        class="flex h-8 w-8 items-center justify-center text-xl leading-none text-black/60 transition-colors hover:text-black"
      >
        &times;
      </button>
    </header>

    <ul class="flex-1 divide-y divide-black/10 overflow-y-auto">
      {
        service.tracks.map((track, i) => (
          <li>
            <button
              type="button"
              class="track-row flex w-full items-center gap-3 px-6 py-3 text-left transition-colors hover:bg-black/5 data-[current=true]:bg-brand-primary/10"
              data-src={track.src}
              data-title={track.title}
              data-index={i}
            >
              <span
                class="play-icon flex h-7 w-7 shrink-0 items-center justify-center text-brand-primary"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-medium">{track.title}</span>
                {track.artist && <span class="block text-xs text-black/50">{track.artist}</span>}
              </span>
              <span class="shrink-0 text-xs tabular-nums text-black/50">{track.duration}</span>
            </button>
          </li>
        ))
      }
    </ul>

    <div class="border-t border-black/10 px-6 py-4">
      <p data-now-playing class="mb-3 truncate text-center text-sm font-medium text-black/70">
        Select a track to play
      </p>

      <div
        data-progress-track
        class="relative mb-3 h-1.5 cursor-pointer rounded-full bg-black/10"
      >
        <div
          data-progress-fill
          class="pointer-events-none h-full w-0 rounded-full bg-brand-primary"
        >
        </div>
      </div>

      <div class="flex items-center justify-between gap-4">
        <span data-current-time class="w-10 text-xs tabular-nums text-black/50">0:00</span>

        <div class="flex items-center gap-5">
          <button type="button" data-prev aria-label="Previous track" class="text-black/70 transition-colors hover:text-black disabled:opacity-30">
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
              <path d="M6 6h2v12H6zm3.5 6 8.5 6V6z" />
            </svg>
          </button>

          <button
            type="button"
            data-play-pause
            aria-label="Play"
            class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-primary text-white transition-colors hover:bg-brand-primary-dark"
          >
            <svg data-icon-play viewBox="0 0 24 24" class="h-5 w-5 fill-current">
              <path d="M8 5v14l11-7z" />
            </svg>
            <svg data-icon-pause viewBox="0 0 24 24" class="hidden h-5 w-5 fill-current">
              <path d="M6 5h4v14H6zm8 0h4v14h-4z" />
            </svg>
          </button>

          <button type="button" data-next aria-label="Next track" class="text-black/70 transition-colors hover:text-black disabled:opacity-30">
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
              <path d="M16 18h2V6h-2zM6 18l8.5-6L6 6z" />
            </svg>
          </button>
        </div>

        <span data-duration class="w-10 text-right text-xs tabular-nums text-black/50">0:00</span>
      </div>
    </div>

    <audio data-audio-el preload="none"></audio>
  </div>
</dialog>
