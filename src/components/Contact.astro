---
---

<section id="contact" class="flex flex-col">
  <div class="mx-auto flex w-full max-w-lg flex-col bg-black px-6 py-12 sm:px-12 sm:py-20">
    <h2 class="mb-8 text-center text-3xl font-semibold text-white md:text-4xl">
      Let's start a dialogue
    </h2>

    <form
      id="contact-form"
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="flex flex-col gap-4"
      novalidate
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>
          Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </label>
      </p>

      <div class="flex flex-col gap-1.5">
        <label for="name" class="text-sm font-medium text-white">
          Name <span aria-hidden="true" class="text-red-400">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          placeholder="That'll be you!"
          class="border border-black/20 bg-white px-3.5 py-3 text-black placeholder:text-black/60 focus:outline-2 focus:outline-offset-2 focus:outline-brand-primary"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="email" class="text-sm font-medium text-white">
          Email <span aria-hidden="true" class="text-red-400">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          placeholder="Whatever works"
          class="border border-black/20 bg-white px-3.5 py-3 text-black placeholder:text-black/60 focus:outline-2 focus:outline-offset-2 focus:outline-brand-primary"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="message" class="text-sm font-medium text-white">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder="Go for it! Speak your mind..."
          class="resize-y border border-black/20 bg-white px-3.5 py-3 text-black placeholder:text-black/60 focus:outline-2 focus:outline-offset-2 focus:outline-brand-primary"
        ></textarea>
      </div>

      <button
        type="submit"
        class="mt-2 w-full bg-brand-primary px-6 py-4 text-xs font-semibold tracking-[1px] text-white uppercase transition-colors hover:bg-brand-primary-dark disabled:cursor-not-allowed disabled:opacity-60"
      >
        Submit
      </button>

      <p id="contact-form-status" class="hidden text-center text-sm text-white/80" role="status"></p>
    </form>
  </div>

  <h2 class="mx-8 my-8 mt-16 text-center text-4xl font-bold text-black md:mb-24 md:text-5xl">
    Mic drop.
  </h2>
</section>

<script>
  // Submits to Netlify Forms via AJAX so the page doesn't reload. Netlify's
  // build bot detects this form from its static markup (data-netlify,
  // the form-name hidden field) and only actually captures submissions once
  // deployed on Netlify — locally this fetch will fail, which is expected.
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLParagraphElement>("#contact-form-status");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  function encodeForNetlify(data: FormData): string {
    const params = new URLSearchParams();
    data.forEach((value, key) => {
      if (typeof value === "string") params.append(key, value);
    });
    return params.toString();
  }

  function setStatus(message: string) {
    if (!status) return;
    status.textContent = message;
    status.classList.remove("hidden");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
    }

    try {
      const response = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: encodeForNetlify(new FormData(form)),
      });

      if (!response.ok) throw new Error(`${response.status}`);

      setStatus("Thanks — your message is on its way!");
      form.reset();
    } catch {
      setStatus("Something went wrong sending that. Please email krayneli@gmail.com instead.");
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Submit";
      }
    }
  });
</script>
