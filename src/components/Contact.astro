---

<section id="contact" class="flex flex-col">
  <div class="mx-auto flex w-full max-w-lg flex-col bg-black px-6 py-12 sm:px-12 sm:py-20">
    <h2 class="mb-8 text-center text-3xl font-semibold text-white md:text-4xl">
      Let's start a dialogue
    </h2>

    <form id="contact-form" class="flex flex-col gap-4" novalidate>
      <div class="flex flex-col gap-1.5">
        <label for="name" class="text-sm font-medium text-white">
          Name <span aria-hidden="true" class="text-red-400">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="That'll be you!"
          class="border border-white/25 bg-white px-3.5 py-3 text-black placeholder:text-black/50 focus:outline-2 focus:outline-brand-primary"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="email" class="text-sm font-medium text-white">
          Email <span aria-hidden="true" class="text-red-400">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="Whatever works"
          class="border border-white/25 bg-white px-3.5 py-3 text-black placeholder:text-black/50 focus:outline-2 focus:outline-brand-primary"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="message" class="text-sm font-medium text-white">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder="Go for it! Speak your mind..."
          class="resize-y border border-white/25 bg-white px-3.5 py-3 text-black placeholder:text-black/50 focus:outline-2 focus:outline-brand-primary"
        ></textarea>
      </div>

      <button
        type="submit"
        class="mt-2 w-full bg-brand-primary px-6 py-4 text-xs font-semibold tracking-[1px] text-white uppercase transition-colors hover:bg-brand-primary-dark disabled:cursor-not-allowed disabled:opacity-60"
      >
        Submit
      </button>

      <p id="contact-form-status" class="hidden text-center text-sm text-white/80" role="status"></p>
    </form>
  </div>

  <h2 class="mx-8 my-8 mt-16 text-center text-4xl font-bold text-black md:mb-24 md:text-5xl">
    Mic drop.
  </h2>
</section>

<script>
  // TODO: wire this up to a form backend (e.g. Web3Forms, Formspree, or a
  // serverless function). Currently a placeholder that validates and shows
  // a status message without sending data anywhere.
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLParagraphElement>("#contact-form-status");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
    }

    window.setTimeout(() => {
      if (status) {
        status.textContent =
          "Form UI is ready — connect a form backend to actually deliver submissions.";
        status.classList.remove("hidden");
      }
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Submit";
      }
    }, 500);
  });
</script>
